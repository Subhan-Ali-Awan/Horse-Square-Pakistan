{
  "buildCommand": "npm install && cd client && npm install && npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/mail-dispatcher",
      "destination": "/api/mail-dispatcher.js"
    },
    {
      "source": "/api/mail-dispatcher",
      "destination": "/api/mail-dispatcher.js"
    },
    {
      "source": "/api/(.*)",
      "destination": "https://horse-square-pakistan.onrender.com/api/$1"
    },
    {
      "source": "/uploads/(.*)",
      "destination": "https://horse-square-pakistan.onrender.com/uploads/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

