# Server Configuration
PORT=5001
NODE_ENV=development

# Frontend URL (for CORS allowance in production)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
# Local: mongodb://127.0.0.1:27017/horsesquare
# Cloud: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/horsesquare?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/horsesquare

# Authentication
JWT_SECRET=horsesquare_super_secret_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Default Admin (created on initial launch)
ADMIN_EMAIL=admin@horsesquare.pk
ADMIN_PASSWORD=Admin@12345

# AI Equine Veterinary Assistant (Dr. Max)
# 1. Primary Engine: OpenRouter AI Key (from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_API_KEY_BACKUP=sk-or-v1-...
OPENROUTER_MODEL=openrouter/auto

# 2. OpenAI Official API Key (from https://platform.openai.com)
OPENAI_API_KEY=sk-...

# 3. High-Speed Fallback Engine: Groq API Key (from https://console.groq.com)
GROQ_API_KEY=gsk_...


# Cloudinary (Optional - for image storage)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
